# Copy to .env and adjust. Values below are local development defaults only.
POSTGRES_USER=perf
POSTGRES_PASSWORD=change-me
POSTGRES_DB=perf

GRAFANA_ADMIN_PASSWORD=change-me

INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-me-min-8-chars
INFLUXDB_ORG=perf
INFLUXDB_BUCKET=jmeter
# Admin token used by JMeter's backend listener (generate with: openssl rand -hex 32)
INFLUXDB_TOKEN=change-me
